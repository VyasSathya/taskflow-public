{
  "name": "@vibetasks/cli",
  "version": "0.5.3",
  "description": "VibeTasks CLI - Lightning-fast task management from your terminal. Works with Claude Code, Cursor, and all AI coding tools.",
  "author": "Vyas",
  "license": "MIT",
  "type": "module",
  "main": "./dist/bin/vibetasks.js",
  "bin": {
    "vibetasks": "./dist/bin/vibetasks.js"
  },
  "files": [
    "dist",
    "hooks",
    "package.json"
  ],
  "keywords": [
    "vibetasks",
    "vibe",
    "vibecoding",
    "cli",
    "task-management",
    "productivity",
    "mcp",
    "claude-code",
    "cursor",
    "ai-tools",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vyassathya/vibetasks.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vibetasks.dev",
  "bugs": {
    "url": "https://github.com/vyassathya/vibetasks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx bin/vibetasks.ts",
    "build": "tsup bin/vibetasks.ts src/daemon-worker.ts --format esm --clean --outDir dist --shims",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibetasks/core": "^0.5.3",
    "@vibetasks/shared": "^1.2.3",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "cli-table3": "^0.6.3",
    "inquirer": "^9.2.12",
    "date-fns": "^3.0.0",
    "clipboardy": "^4.0.0",
    "node-notifier": "^10.0.1",
    "node-global-key-listener": "^0.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
