# Site Config
NEXT_PUBLIC_APP_NAME=YourApp
NEXT_PUBLIC_SITE_URL=https://yourapp.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourapp.com

# App Store Links
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/your-app/id123456789
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.yourcompany.yourapp
NEXT_PUBLIC_TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXX

# Deep Link Scheme (must match your mobile app)
NEXT_PUBLIC_APP_SCHEME=yourapp

# Supabase (same project as mobile app - optional for waitlist)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
