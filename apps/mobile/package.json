{
  "name": "taskflow-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prestart": "node scripts/check-node-version.js",
    "start": "node scripts/start-dev.js",
    "tunnel": "node scripts/start-dev.js tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "device": "node scripts/build-device.js",
    "web": "node scripts/start-dev.js web",
    "build:ios": "eas build --profile development --platform ios --non-interactive && pnpm builds",
    "build:android": "eas build --profile development --platform android --non-interactive && pnpm builds",
    "build:android:apk": "eas build --profile production-apk --platform android --non-interactive && pnpm builds",
    "build:devs": "eas build --profile development --platform all --non-interactive && pnpm builds",
    "build:all": "node scripts/release-all.js",
    "ship": "node scripts/release-all.js",
    "submit:ios": "eas submit --platform ios --latest && pnpm builds",
    "submit:android": "eas submit --platform android --latest && pnpm builds",
    "release:ios": "eas build --profile production --platform ios --auto-submit && pnpm builds",
    "release:android": "eas build --profile production --platform android --auto-submit && pnpm builds",
    "testflight": "pnpm release:ios",
    "release": "node scripts/release.js",
    "builds": "node scripts/show-builds.js",
    "builds:wait": "node scripts/show-builds.js --wait",
    "version:bump": "node scripts/bump-version.js",
    "version:bump:ios": "node scripts/bump-version.js --ios",
    "version:bump:android": "node scripts/bump-version.js --android",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.16",
    "@vibetasks/shared": "*",
    "babel-preset-expo": "^54.0.9",
    "date-fns": "^4.1.0",
    "expo": "~54.0.30",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^15.0.10",
    "lottie-react-native": "^7.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "^0.7.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "jsonwebtoken": "^9.0.3",
    "patch-package": "^8.0.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
